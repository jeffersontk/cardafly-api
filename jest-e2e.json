{
  "moduleFileExtensions": ["ts", "js", "json"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.[tj]s$": [
      "ts-jest",
      { "tsconfig": "tsconfig.json", "isolatedModules": true, "useESM": false }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@noble|@paralleldrive)/)"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
